# Copy to .env.local (the app's own config) and/or .env (the service key). Both are gitignored.
# Never commit real values, and never give a secret a VITE_ prefix: Vite ships every VITE_
# variable to the browser.

# App + one-off scripts: the project URL and the PUBLIC anon/publishable key (safe in the bundle).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon or sb_publishable key>

# Feature flag: "true" routes the app through the database.
VITE_USE_DB=true

# Scripts that WRITE (bypass RLS). Put this in .env, not .env.local. It is a secret.
SUPABASE_SERVICE_KEY=<service_role or sb_secret key>
