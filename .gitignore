
# local visual-audit tooling
*.local
.DS_Store
.shots/
dist/
node_modules/
.env.local
.env

# local-only service key for catalog loads (never commit)
.env.load

# per-screen text dumps written by the browser guards (check:ui --snapshot,
# check:zero --dump). CI uploads them as build artifacts; locally they are scratch,
# and a committed one would read as a checked-in expectation that nothing updates.
ui-screens.json
zero-state.json
before.json
after.json

# regenerable catalog data — lives in Supabase, re-pull via etl-state.mjs
catalog/**/*.json
supabase/seed-utah.sql

# Supabase CLI scratch state — written by `supabase link` / `functions deploy`,
# holds this machine's project-ref and the remote's component versions. Purely
# local and regenerated on demand; committing it would hand every clone one
# developer's linked project.
#
# NO TRAILING SLASH, deliberately. The slashed form matches a DIRECTORY only, and a
# worktree reaches this state by SYMLINKING it from the main checkout — the same way
# .env and .env.local already are. A symlink is not a directory to git, so the slashed
# pattern let it show up as untracked, one `git add .` away from committing one
# developer's project ref. Without that link a worktree cannot run the `--linked` guards
# (check:function-drift, check:function-columns) at all.
supabase/.temp

# local Claude Code permissions — personal, not shared across clones
.claude/settings.json
scripts/oneoff/peak-reachability.json

# Interrupted-run marker written by scripts/oneoff/inject-glued-name-cases.mjs.
# Its presence means a harness was killed mid-injection; the harness restores from git on
# the next start. It must never be committed.
scripts/oneoff/.inject-glued-name-INPROGRESS

# Raw DEM readings cached by scripts/oneoff/build-ground-disagreement-index.mjs so a re-run
# costs no requests. Derived data — lib/ground-checked-pins.js is the committed product.
.ground-readings-cache.json

# Regenerable run artifact of scripts/oneoff/solve-camp-elevations.mjs (~10 min to rebuild).
camp-elevation-proposals.json
# check:waypoint-placement bundles its render probe INSIDE the project (node must resolve react
# from the nearest node_modules). It removes the dir in a finally, but a killed run would leave one.
.wpplace-*/
.camp-geocode-cache.json
