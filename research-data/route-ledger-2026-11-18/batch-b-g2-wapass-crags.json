    "set": {
      "waypoints": [
        {
          "lat": 48.51454,
          "lng": -120.64332,
          "elev": 5200,
          "name": "SR-20 Hairpin / Pond Pullout (east of Washington Pass)",
          "type": "Trailhead",
          "distMi": 0,
          "elevFt": 5200,
          "directions": "Park in the pullout on the north side of SR-20 at the hairpin curve, roughly 0.3 to 0.5 mile past the Washington Pass Overlook turnoff and a short distance east of Washington Pass. SR-20 is gated for the winter and typically doesn't reopen until mid-to-late April or early May, so this approach isn't accessible until the highway opens for the season."
        },
        {
          "lat": 48.515435,
          "lng": -120.658365,
          "elev": 7720,
          "name": "Liberty Bell Mountain summit",
          "type": "Summit",
          "distMi": 1.3,
          "elevFt": 7720,
          "directions": "From the talus, pick the line by the huge roof above you — the Lithuanian Lip — with Liberty Crack the continuous crack passing to its right; do not scramble straight up the fall line beneath it, which lands parties on the neighbouring East Face routes. The standard entry traverses in from the left for roughly 40 feet on third- and fourth-class ledges to the ledges under the true first-pitch crack, and twelve pitches then lead to the bolted alcove near the summit shoulder."
        }
      ]
    },
