 "wy_cathedral_buttress_the_widowmaker": {
  "area": "wy_cathedral_buttress",
  "set": {
   "descent_text": "Go down by way of the Snaz chimneys and the gully beyond them, reached by a steep couloir that drops from the summit area toward the south-west. The ground is loose and dirty with some easy slab scrambling, so it is a poor place to rappel and unpleasant when wet. Rock knocked down the gully can reach climbers on the south-facing Cathedral Rock routes below."
  },
  "review": {
   "sources": [
    "https://www.mountainproject.com/route/124825694/the-widowmaker",
    "https://tenthousandtoofar.com/2023/09/03/visceral-inspiration-the-widowmaker-5-9r-iii-cathedral-rock-death-canyon-gtnp-wy-08-24-23/"
   ],
   "confidence": "medium",
   "notes": "Both pages name the Snaz descent and the couloir south of the summit."
  }
