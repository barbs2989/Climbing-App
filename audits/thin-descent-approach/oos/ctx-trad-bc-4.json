  {
   "approach": null,
   "area_id": "bc_slesse_mountain",
   "descent": null,
   "descent_text": "The six pitches from the northern notch finish on the summit of Slesse, so the descent is the standard one. From the summit, take the standard Crossover descent. Work down the west side of the summit ridge by cairned scrambling, a short rappel from a slung block, and gullies and ledges to the Slesse Mountain Trail; picking the correct gully matters, as cliffs lie beside the wrong one. A cairn marks where the route leaves that trail for a notch, then crosses steep snow (an ice axe is useful) and contours around Mount Parkes to Crossover Pass. From the pass, rappel the bolted Crack of Noon Club route to talus, follow cairns and flagging into the forest, and rejoin the memorial trail to the east-side trailhead. A steep west-side descent to Slesse Creek also exists, but it ends far from the east-side start and road access over there has been restricted.",
   "description": null,
   "discipline": "trad",
   "grade": "5.7",
   "id": "bc_slesse_mountain_north_pillar",
   "name": "North Pillar",
   "need_approach": true,
   "need_descent": false,
   "parent": "Canadian Cascades",
   "peak": "Slesse Mountain",
   "peak_elev": 8002,
   "peak_lat": 49.02561,
   "peak_lng": -121.59192,
   "pitches": 6
  },
  {
