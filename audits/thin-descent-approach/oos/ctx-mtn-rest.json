  {
   "id": "bc_mount_athelstan_kiss_of_death_sinnes_couloir",
   "name": "Kiss of Death (Sinnes Couloir)",
   "grade": "Steep Snow",
   "discipline": "mountaineering",
   "area_id": "bc_mount_athelstan",
   "peak": "Mount Athelstan",
   "peak_lat": 50.71,
   "peak_lng": -123.4408,
   "peak_elev": null,
   "parent": "Sea to Sky (North of Whistler)",
   "pitches": 0,
   "approach": "The Salal Creek forest road, a branch off the Upper Lillooet road north of Pemberton, ends below the Salal Creek walls (forest road conditions vary, so check before driving). From the road end, walk into the forest aiming a little south of the big slide path that drops from the walls, which keeps you out of thick slide alder. When the slope steepens abruptly, drop left and cross through a gap in the brush onto open ground in the slide path, then go up it to the bivy sites below the walls. The approach is short but steep, and an ice axe, sometimes crampons, are needed on the snow early in the season. The approach is shared with the routes on the Randy Stoltmann Buttress. Starting at the foot of Selective Cut, shift right into the narrow couloir that runs between that buttress and the Octopus Beak tower. It is an early-season line that may be mostly dirt by late summer.",
   "descent": null,
   "descent_text": null,
   "description": null,
   "need_descent": true,
   "need_approach": false
  },
