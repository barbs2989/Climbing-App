  {
   "id": "nh_tuckerman_ravine_duchess_the",
   "name": "Duchess, The",
   "grade": "Steep Snow",
   "discipline": "mountaineering",
   "area_id": "nh_tuckerman_ravine",
   "peak": "Tuckerman Ravine",
   "peak_lat": 44.26177,
   "peak_lng": -71.29653,
   "peak_elev": null,
   "parent": "Mount Washington",
   "pitches": 0,
   "approach": "Begin at the Pinkham Notch Visitor Center on Route 16 and hike up the Tuckerman Ravine Trail as far as the Hermit Lake Shelter. Over the bridge you reach the Sherburne Ski Trail; follow it uphill on the left fork to the foot of the Hillman's Highway slide path. The Duchess is the big chute right of Hillman's Highway, cutting the big buttress in two. The lower slide paths see avalanche, ice and rockfall, so check the avalanche forecast.",
   "descent": null,
   "descent_text": null,
   "description": null,
   "need_descent": true,
   "need_approach": false
  },
  {
   "id": "nh_tuckerman_ravine_side_chute",
   "name": "Side Chute",
   "grade": "Steep Snow",
   "discipline": "mountaineering",
   "area_id": "nh_tuckerman_ravine",
   "peak": "Tuckerman Ravine",
   "peak_lat": 44.26177,
   "peak_lng": -71.29653,
   "peak_elev": null,
   "parent": "Mount Washington",
   "pitches": 0,
   "approach": "Begin at the Pinkham Notch Visitor Center on Route 16 and hike up the Tuckerman Ravine Trail as far as the Hermit Lake Shelter. Over the bridge you reach the Sherburne Ski Trail; follow it uphill on the left fork to the foot of the Hillman's Highway slide path. Side Chute leaves Dodge's Drop about halfway up, on the right, through a steep rock pinch before moderate snow. The lower slide paths see avalanche, ice and rockfall, so check the avalanche forecast.",
   "descent": null,
   "descent_text": "After the exit, go up and over and descend easier ground into Hillman's Highway, then come down that gully.",
