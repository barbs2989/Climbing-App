   "name": "All in the Family",
   "need_approach": false,
   "need_descent": true,
   "parent": "Anderson River Group",
   "peak": "Yak Peak",
   "peak_elev": null,
   "peak_lat": 49.6067,
   "peak_lng": -121.10389,
   "pitches": 8
  },
  {
   "approach": "Take the climbers' trail from the highway and scramble a fair way up the descent trail, then cut hard left along a ledge to the base of the central dihedral on the southeast face. It is the most prominent dihedral on that face, between Hole in My Heaven and Madness.",
   "area_id": "bc_yak_peak",
   "descent": null,
   "descent_text": null,
   "description": null,
   "discipline": "trad",
