   "waypoints": [
    {
     "lat": 47.6659,
     "lng": -121.2881,
     "elev": 1650,
     "name": "East Fork Foss River / Necklace Valley Trailhead",
     "note": "Self-issue wilderness permit and Northwest Forest Pass required at the kiosk; trail follows an old railroad grade along the East Fork Foss River.",
     "type": "Trailhead",
     "distMi": 0
    },
    {
     "lat": 47.612611,
     "lng": -121.243994,
     "elev": 2250,
     "name": "East Fork Foss River crossing",
     "note": "Log/boulder-hop ford of the East Fork Foss River with no bridge; can be a difficult, cold crossing at high water or early season.",
     "type": "Hazard",
     "distMi": 5,
     "directions": "The first five miles are the flattest of the route — barely 600 ft of gain along the river through old-growth forest, past established camps, with a spur path near mile 4 dropping to the water. Save your legs here, because everything above the crossing is steep."
    },
    {
     "lat": 47.591124,
     "lng": -121.262033,
     "elev": 4650,
     "name": "Jade Lake",
     "note": "First and largest of the Necklace Valley 'gem' lakes, reached after a steep 2,400 ft climb in 3 miles above the river crossing; established campsites and reliable water, but campfires are banned above 4,000 ft in the wilderness.",
     "type": "Campsite",
     "distMi": 7.4,
     "directions": "Immediately past the river the trail turns steep and stays that way, gaining roughly 2,400 ft in three miles over large boulders and tree roots on rugged, minimally maintained tread. This is the crux of the approach for footing and stamina, and it is slow in both directions."
    },
    {
     "lat": 47.576539,
     "lng": -121.254573,
     "elev": 5600,
     "name": "Scree scramble to La Bohn Lakes",
     "note": "Steep scree/boulder gully gains roughly 950 ft in half a mile above the valley floor to La Bohn Lakes; the boot path is faint and easy to lose, especially in fog or on lingering snow patches.",
     "type": "Hazard",
     "distMi": 8.7,
     "directions": "Continue up-valley past Emerald Lake, where a seasonal stream at the north end is the reliable water, toward Opal and Cloudy Lakes at the head of the valley — the maintained trail effectively ends here and boot paths fan out. From the Opal Lake camp area, pick up the crude unmaintained path climbing beside La Bohn Creek, the outlet stream of the La Bohn Lakes. It is west-facing and unshaded, hot in the afternoon, and there is no dependable water once you leave the valley floor."
    },
    {
     "lat": 47.571842,
     "lng": -121.249746,
     "elev": 5856,
     "name": "La Bohn Gap",
     "note": "Broad saddle often called the geographic center of the Alpine Lakes Wilderness; routes toward Mt. Hinman, Iron Cap Mountain, and La Bohn Peak's east ridge all branch from here.",
     "type": "Junction",
     "distMi": 9.2,
     "directions": "The path eases at the lowest La Bohn Lake; follow the shore and heather benches north to the upper lake, then make a short talus-and-heather traverse east to the broad saddle. Confirm you are at the right saddle before committing to any slope east of it — USGS maps label the gap roughly two-thirds of a mile southeast of its true position, and the ground east of the wrong gap ends in cliffs above Lake Rowena. Lingering snow can mask the correct line into early summer."
    },
    {
     "lat": 47.562486,
     "lng": -121.249868,
     "elev": 6585,
     "name": "La Bohn Peak",
     "note": "Class 2-3 tag-on of roughly 700-1,000 ft from the gap up the east ridge; broad rocky summit with views of Mt. Hinman, Mt. Daniel, and the Necklace Valley lakes below.",
     "type": "Summit",
     "distMi": 9.6
    }
