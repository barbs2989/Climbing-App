   "waypoints": [
    {
     "lat": 47.3663,
     "lng": -120.8027,
     "elev": 3100,
     "name": "Stafford Creek Trailhead",
     "note": "End of FR 9703; ~20-car lot with pit toilet, Northwest Forest Pass or $5 self-issue fee required; trail has seen closures for Labor Mountain Fire damage so check current USFS alerts before going.",
     "type": "Trailhead",
     "distMi": 0,
     "directions": "Drive the Teanaway River Road to 29 Pines Campground, bear right where the pavement ends, then turn onto Stafford Creek Road and follow it a couple of miles to where it ends at the trailhead. The last stretch is dirt and washboarded but passable to low-clearance cars in dry conditions."
    },
    {
     "lat": 47.401465,
     "lng": -120.803455,
     "elev": 4800,
     "name": "Stafford Creek crossing, Stafford Creek Meadows",
     "note": "Stream crossing in the meadows on Trail #1359; last reliable water before the drier climb toward the pass.",
     "type": "Water",
     "distMi": 3.5,
     "directions": "Trail #1359 leaves the lot at an easy grade through dry ponderosa and lodgepole forest, staying close to Stafford Creek most of the way. A short rerouted section of steeper switchbacks near the half-mile mark bypasses old avalanche-damaged tread. The forest stays open and the grade never gets hard before the trail reaches the marshy meadow ground."
    },
    {
     "lat": 47.409686,
     "lng": -120.802068,
     "elev": 5450,
     "name": "Standup Creek Trail junction",
     "note": "Trail #1359 meets the Standup Creek Trail about 2 miles below Navaho Pass; continue straight/left on #1359 toward the pass.",
     "type": "Junction",
     "distMi": 3.8,
     "directions": "Stay on Stafford Creek Trail #1359, still gaining gradually along the creek, to the signed junction with the Standup Creek Trail (#1369)."
    },
    {
     "lat": 47.409284,
     "lng": -120.799768,
     "elev": 5500,
     "name": "Upper meadow camp",
     "note": "Established camp area in the upper meadow, about half a mile below the pass; common overnight staging spot before the steep push above.",
     "type": "Campsite",
     "distMi": 5,
     "directions": "Continue on Trail #1359 above the junction; the trail opens out into a large, marshy subalpine meadow with a feeder stream — another water source, and the usual base camp for parties splitting the trip over two days."
    },
    {
     "lat": 47.414557,
     "lng": -120.795687,
     "elev": 6000,
     "name": "Navaho Pass",
     "note": "Junction with the old County Line Trail (Cascade Creek Trail #1217); barren, rocky 'moon-scape' terrain with big Enchantments views, but very exposed to wind for camping.",
     "type": "Junction",
     "distMi": 5.85,
     "directions": "Above the meadow the trail leaves the trees and switchbacks up open, rocky slope for the last stretch, gaining roughly 500 ft to the saddle. There is no water and essentially no shade on this section, and on the dry east side it bakes on a warm afternoon."
    },
    {
     "lat": 47.418341,
     "lng": -120.799937,
     "elev": 6600,
     "name": "South ridge scramble path",
     "note": "Steep climber's path of loose scree and dirt gaining the south ridge; snow patches can linger into July, making poles/microspikes worthwhile.",
     "type": "Hazard",
     "distMi": 6.3,
     "directions": "From the pass turn east and follow the crest trail a short way toward the peak, then leave it where a boot path breaks off uphill onto the south ridge. The path is loose scree over dirt and steepens quickly, so poles earn their keep and it is easy to push rock down onto anyone below you."
    },
    {
     "lat": 47.4226199,
     "lng": -120.803141,
     "elev": 7223,
     "name": "Navaho Peak",
     "note": "True summit at 7,223 ft on the Alpine Lakes Wilderness boundary; panoramic views of the Enchantments and Stuart Range.",
     "type": "Summit",
     "distMi": 6.85,
     "directions": "Follow the crest up for a bit over 600 ft of gain on broken rock and scree; the scrambling stays easy Class 2 with hands wanted only occasionally. Stay on the ridge line rather than dropping onto the looser slopes on either side, which are steeper than they look from above."
    }
   ],
