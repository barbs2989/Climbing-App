  {
   "id": "wa_alta_mountain_scramble",
   "waypoints": [
    {
     "lat": 47.4009,
     "lng": -121.2836,
     "elev": 2800,
     "name": "Rachel Lake Trailhead",
     "note": "Trail #1313 start off FR 4930; Northwest Forest Pass plus self-issued wilderness permit required (USFS Rachel Lake Trailhead page).",
     "type": "Trailhead",
     "distMi": 0,
     "directions": "From I-90 Exit 62, follow Kachess Lake Road to FS Road 4930 and drive it to the road end at about 2,800 ft. Trail #1313 leaves the parking area; a Northwest Forest Pass plus a self-issued wilderness permit are required at the board."
    },
    {
     "lat": 47.4227,
     "lng": -121.3292,
     "elev": 4667,
     "name": "Rachel Lake",
     "note": "~4.1 mi from the trailhead, at the top of the steep, rooty 'mile from hell' climb.",
     "type": "Water",
     "distMi": 4.1,
     "directions": "Trail #1313 runs beside Box Canyon Creek on gentle grade for roughly 2.75 miles, crossing several side streams and cascades — water is reliable the whole way, so there is no need to carry much from the car. Past the creek crossing the trail turns into the rooty, rocky boot-beaten climb locals call the 'mile from hell': about 1,300 ft of gain in a mile with large step-ups and no switchbacks. It is a fitness crux, not a technical one, but it is brutal under a full pack."
    },
    {
     "lat": 47.42,
     "lng": -121.334,
     "elev": 5100,
     "name": "Rampart Ridge / Rampart Lakes junction",
     "note": "Ridge crest above Rachel Lake where the maintained trail splits toward Rampart Lakes and Lila Lake. Coordinate is a trail-guide interpolation (no exact published fix found), cross-checked against a nearby Rampart Lakes basin waypoint at 47.4182,-121.3376.",
     "type": "Junction",
     "distMi": 4.6,
     "directions": "At the lake a use path branches off near the outhouse and skirts the north shore. From there it switchbacks steeply up rocky tread for about half a mile to the crest of Rampart Ridge, where the maintained trail splits toward Rampart Lakes and toward Lila Lake."
    },
    {
     "lat": 47.4285,
     "lng": -121.3332,
     "elev": null,
     "name": "Alta climbers' path turnoff (cairn)",
     "note": "Cairned fork on the Lila Lake trail about 0.3 mi past the Rampart Ridge junction, where the unmarked climbers' path up Alta's south ridge leaves on the left. Coordinate is an estimate between the ridge junction and the summit, not surveyed.",
     "type": "Junction",
     "distMi": null,
     "directions": "At the ridge-top junction above Rachel Lake, go right toward Lila Lake (the left branch leads to Rampart Lakes). The tread is brushy in places but always clear; after about 0.3 mile a cairn marks the fork where the Lila Lake trail carries straight on and the climbers' path to Alta leaves on the left."
    },
    {
     "lat": 47.441131,
     "lng": -121.331964,
     "elev": 6275,
     "name": "Alta Mountain summit",
     "note": "Reached past several false summits along the exposed ridge crest.",
     "type": "Summit",
     "distMi": 6,
     "directions": "At the cairned fork on the Lila Lake trail an unmarked climbers' path leaves the maintained trail and follows the ridge crest toward the summit block. It starts steep, loose and shadeless with large steps, then eases onto a narrow crest with sustained exposure: expect several class 2-3 moves, at least one near-vertical step of six to eight feet with good holds, a short class 3 downclimb near the top, and three or more false summits before the real one. Do not attempt this stretch with snow on the crest or on wet rock — the path skirts a cliff edge and the fall consequences are serious. Helmets are worth wearing for the loose rock."
    }
   ],
