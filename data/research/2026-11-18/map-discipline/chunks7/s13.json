 {
  "id": "wa_himmelhorn_stonehenge",
  "name": "Stonehenge",
  "peakName": "Himmelhorn",
  "state": "Washington",
  "discipline": "alpine",
  "status": "new",
  "peak": {
   "id": "wa_himmelhorn",
   "name": "Himmelhorn",
   "lat": 48.77639,
   "lng": -121.31472,
   "elevation_ft": 7880,
   "region": "Washington",
   "path": "usa.washington.wa_northwest.wa_hwy20_ncnp.wa_north_cascades.wa_picket_range.wa_southern_pickets.wa_himmelhorn"
  },
  "text": {
   "approach": "From a high camp below the Chopping Block above Crescent Creek Basin, the party left at 4 a.m., reached the snow slope below the wall by 5 a.m., then climbed roughly 600 ft of easy rock ramps and ledges to a grassy col at the base of the wall where they racked up.",
   "approach_logistics": null,
   "road": "{\"name\":\"North Cascades Highway (SR-20) to Goodell Creek Trailhead\",\"status\":\"Paved and open year-round to Goodell Creek, near Newhalem\",\"driveNote\":\"Trailhead sits at roughly 600 ft elevation directly off SR-20\",\"seasonalGate\":\"SR-20 closes seasonally in winter further east near Ross Dam/Washington Pass, but this does not affect the lower, western Goodell Creek approach\"}",
   "overview": "An 8-pitch 5.10- line up Himmelhorn's previously-unclimbed south face, established in July 2015, finishing up a summit tower via steep, run-out faces separated by easier ground.",
   "description": null,
   "descent": "From the top of the difficulties, a traverse reaches a notch on the ridge, and one easy but loose pitch leads from there up to the summit. No descent line or rappel count has been recorded for the way back down."
  },
