  "id": "wa_enchantment_peak_east_ridge",
  "name": "East Ridge (Prusik Pass)",
  "discipline": "scrambling",
  "grade": "Class 3",
  "verdict": "SUMMIT_ONLY",
  "state": "wa",
  "peak": {
   "id": "wa_enchantment_peak",
   "name": "Enchantment Peak",
   "lat": 47.4875,
   "lng": -120.806389,
   "elevation_ft": 8538,
   "region": "Washington",
   "path": "usa.washington.wa_centraleast.wa_stuart_range.wa_enchantment_peak"
  },
  "text": {
   "approach": "Reach Prusik Pass either from the west (Stuart Lake TH -> Colchuck Lake -> Aasgard Pass -> across the core Enchantment basin) or from the north/east via the longer Snow Creek/Snow Lakes trail (FST 1553) and the upper basin. From Prusik Pass, head west onto Enchantment Peak's east ridge.",
   "approach_logistics": null,
   "road": "{\"name\":\"Icicle Creek Road (FR 76) to Eightmile Rd (FR 7601), or Icicle Creek Rd to the Snow Lakes TH\",\"status\":\"Paved then gravel; normally passable to passenger cars in season\",\"driveNote\":\"Via the Colchuck/Stuart side: from US-2 in Leavenworth, drive Icicle Creek Road 8.4 mi, turn onto Eightmile Rd/FR 7601, and continue 3.8 mi to the Stuart Lake Trailhead.\",\"seasonalGate\":\"Access roads to these trailheads are typically gated in winter\"}",
   "overview": "The most-traveled, standard line up Enchantment Peak: reach Prusik Pass from the core Enchantment basin, then work west along the peak's east ridge over a couple of minor humps to a short, exposed 3rd-class step onto the small, flat true summit block.",
   "description": null,
   "descent": "Downclimb the short 3rd-class step off the summit block carefully, then walk the ridge's minor humps back east to Prusik Pass. From there, descend the same way you came in — either back over Aasgard Pass to Colchuck Lake, or out via the Snow Lakes trail if approached from that side."
  },
  "waypoints": [
   {
    "lat": 47.489186,
